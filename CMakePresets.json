{
    "version": 2,
    "configurePresets": [
        {
            "name": "MPC5566-Flash-Release",
            "displayName": "MPC5566 E78 Flash Application",
            "description": "Book E application stored at 0x80000 and entered by the E78 bootloader at 0x80010",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build/MPC5566-Flash-Release",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain.cmake",
                "CMAKE_OBJCOPY": "powerpc-eabivle-objcopy",
                "MPC5566_BOOTLOADER_IMAGE": "${sourceDir}/bootloader.bin",
                "CMAKE_C_FLAGS": "-DNDEBUG -Os -Wall -fmessage-length=0 -fstrict-volatile-bitfields -ffunction-sections -fdata-sections -mcpu=e200z7 -specs=nano.specs -mbig -mno-vle -mregnames -mhard-float -fmerge-all-constants -fno-ident",
                "CMAKE_CXX_FLAGS": "-DNDEBUG -Os -Wall -fmessage-length=0 -fstrict-volatile-bitfields -ffunction-sections -fdata-sections -mcpu=e200z7 -specs=nano.specs -mbig -mno-vle -mregnames -mhard-float -fno-exceptions -fno-rtti -fmerge-all-constants -fno-ident",
                "CMAKE_ASM_FLAGS": "-DNDEBUG -mcpu=e200z7 -mbig -mno-vle -mregnames",
                "CMAKE_EXE_LINKER_FLAGS": "-Wl,--gc-sections -mcpu=e200z7 -specs=nosys.specs -mbig -mno-vle -mhard-float -T\"${sourceDir}/MPC5566_FLASH.ld\""
            }
        }
    ]
}
