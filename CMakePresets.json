{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "MPC5566-Flash-Release",
      "displayName": "MPC5566 E78 Clang Flash Application",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_FLAGS_RELEASE": "-mcpu=e200z6 -O3 -DNDEBUG -Wall -Wextra",
        "CMAKE_CXX_FLAGS_RELEASE": "-mcpu=e200z6 -O3 -DNDEBUG -Wall -Wextra -fc++-static-destructors",
        "CMAKE_ASM_FLAGS_RELEASE": "-mcpu=e200z6",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-Wl,--gc-sections -Wl,-Map,firmware.map -T\"${sourceDir}/MPC5566_FLASH.ld\"",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MPC5566_BOOTLOADER_IMAGE": "${sourceDir}/bootloader.bin"
      },
      "description": "Book E application with a compact header at 0x80000 and entry at 0x80018"
    }
  ],
  "buildPresets": [
    {
      "name": "MPC5566-Flash-Release",
      "configurePreset": "MPC5566-Flash-Release"
    }
  ]
}
